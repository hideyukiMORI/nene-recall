# NeNe Recall 設定例。cp .env.example .env して埋める。
# .env はコミットしないこと（.gitignore 済み）。

# 待ち受けアドレス
RECALL_ADDR=:8080

# SQLite ファイルのパス
RECALL_DB_PATH=recall.db

# 埋め込みプロバイダ: voyage | local
RECALL_EMBEDDER=voyage

# 埋め込みモデルと次元数。
# 変更したら保存済みベクトルは無効になる。次元が同じでも比較できない（ADR 0005）。
RECALL_EMBED_MODEL=voyage-4
RECALL_EMBED_DIMENSIONS=1024

# 合成の既定の重み: score = alpha*vector + (1-alpha)*lexical
RECALL_DEFAULT_ALPHA=0.7

# Voyage AI の API キー。https://voyageai.com で取得する。
# Anthropic は埋め込みモデルを提供していないため、埋め込みは別プロバイダになる。
VOYAGE_API_KEY=
