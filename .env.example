# NeNe Recall 設定例。cp .env.example .env して埋める。
# .env はコミットしないこと（.gitignore 済み）。
#
# 既定構成は「完全ローカル・費用0円」。外部 API を1回も呼ばない。

# ── サーバ ────────────────────────────────────────────────
RECALL_ADDR=:8080

# ── ストア ────────────────────────────────────────────────
# postgres | sqlite
#   postgres … PostgreSQL + pgvector（既定・ADR 0007）
#   sqlite   … Go 側の総当たり内積と FTS5 の bm25。同一データでの比較実測用
#              （ADR 0017）。どちらも実装済みで、どちらでも起動する
# 🔴 既定は postgres のままにすること。sqlite は比較のための経路であって、
#    既定を移すのは実測を見て ADR を書いてからである（ADR 0007）。
RECALL_STORE=postgres
# ポートが 5433 なのは、5432 をネイティブ PostgreSQL が占有しているため。
# 理由は compose.yaml のコメントを参照。5432 に戻すとネイティブ側へ繋がる。
RECALL_DATABASE_URL=postgres://recall:recall@localhost:5433/recall?sslmode=disable

# RECALL_STORE=sqlite のときだけ使う。ファイルが無ければ作られる。
# ⚠️ 同じファイルを別の埋め込みモデル・別の分割器で開くと、起動はするが
#    最初の検索・取り込みでエラーになる（ADR 0005 の不一致検知）。
#    モデルを変えたら取り込み直すこと。
RECALL_DB_PATH=recall.db

# ── 語彙分割器 ────────────────────────────────────────────
# bigram | kagome
#   bigram … 文字 bigram（既定・ADR 0014）。依存が少ない
#   kagome … 形態素解析 + IPA 辞書（ADR 0018）。純 Go・辞書はバイナリ埋め込み
# 🔴 既定は bigram のままにすること。kagome は要件定義 Q-2 を実測で決着させる
#    ための比較対象であって、既定を移すのは実測を見て ADR を書いてからである。
# ⚠️ 分割器を変えると保存済みの lexeme_text と噛み合わない。tokenizer_id の
#    不一致検知が発火して検索・取り込みが落ちるので、取り込み直しが要る。
# ⚠️ alpha の既定 0.8 は bigram で掃引した値である（ADR 0015 Decision 3）。
#    分割器を変えたら測り直すこと。
RECALL_TOKENIZER=bigram

# ── 埋め込み ──────────────────────────────────────────────
# ollama | voyage
#   ollama … ローカル実行（既定・費用0円・ADR 0008）
#   voyage … 外部 API。任意経路。選んだときだけ VOYAGE_API_KEY が要る
# 🔴 Phase 1 で動くのは ollama だけ。voyage を選ぶと起動時にエラーで止まる
# （設定としては valid だが未実装。ADR 0008 のとおり既定はローカル実行）。
RECALL_EMBEDDER=ollama
RECALL_EMBED_MODEL=bge-m3
RECALL_EMBED_DIMENSIONS=1024

# Ollama の接続先。
# Ollama は Windows 側でネイティブ実行する想定（RTX 3090 をそのまま使うため）。
# WSL からホストを引くアドレスは環境で変わるので、実測して書き換えること。
#   例) http://localhost:11434            … WSL 内で Ollama を動かす場合
#   例) http://<Windows のIP>:11434       … ipconfig / ip route で確認する
RECALL_OLLAMA_URL=http://localhost:11434

# ⚠️ 埋め込みモデルを変えたら保存済みベクトルは無効になる。
#    次元が同じでも異なるモデルのベクトルは比較できず、
#    エラーにならないまま無意味なスコアが返る（ADR 0005）。

# ── 検索 ──────────────────────────────────────────────────
# score = alpha*vector + (1-alpha)*lexical
# 既定 0.8 は ADR 0015 が実測から選んだ値。2026-09-02 の評価セット・bge-m3:1024・
# bigram・語彙スコアのクエリ内正規化という条件で、プラトー（0.7〜0.9）の中心。
# ⚠️ 「最適値」ではない。上の条件のどれかを変えたら測り直すこと（ADR 0015 Decision 3）。
# `make eval EVAL_ALPHA=<値>` で条件を変えて測れる（ADR 0013）。
RECALL_DEFAULT_ALPHA=0.8

# ── 認証（任意）──────────────────────────────────────────────
# 設定すると /v1/* に Bearer 認証が掛かる（ADR 0020 Decision 3）。
# 空なら認証なし——個人のローカル利用が既定である。
#
# 🔴 既定値は無い。「未設定なら既定のトークン」にすると、設定を忘れた全員が
#    同じ鍵を使う状態になる。
# 🔴 /healthz と /readyz は常に認証不要。監視系から「落ちている」と
#    「認証されていない」の区別がつかなくなるため。
# 🔴 この値はログにもエラー応答にも出ない。起動ログに出るのは auth=enabled/disabled だけ。
# ⚠️ recallctl 側の環境変数は RECALL_TOKEN（別名）である。同じ機械で両方を動かすとき、
#    サーバの設定がクライアントにも効くと「設定した覚えのないトークンが付いていた」が起きる。
RECALL_API_TOKEN=

# ── 評価（make eval）────────────────────────────────────────
# 評価は専用 DB recall_eval を毎回 DROP して作り直す。開発用の recall にも
# テスト用の recall_test にも相乗りしない（無関係な行が順位を汚染するため）。
#
# 🔴 評価用の接続情報はここでは設定しない。cmd/eval/main.go の定数が正である。
#    環境変数で分岐できる余地を作らないのは internal/store/postgres/main_test.go と
#    同じ理由による（ローカルと CI が同じものを見る・QLT-003）。
#    ポート 5433 の同期箇所は5つ: compose.yaml / .github/workflows/ci.yml /
#    この .env.example / internal/store/postgres/main_test.go / cmd/eval/main.go
#
# 評価そのものは RECALL_OLLAMA_URL と RECALL_EMBED_MODEL をこのファイルから使う。

# ── 任意: Voyage AI（RECALL_EMBEDDER=voyage のときだけ）────
# Anthropic は埋め込みモデルを提供していないため、外部経路は Voyage を使う。
# 従量課金（voyage-4 = $0.06/1M・最初の200Mトークンは無料）。
VOYAGE_API_KEY=
